{
  "name": "tyche-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/*.test.mjs",
    "e2e": "pnpm --filter terminal e2e",
    "parity": "node --test crates/tyche-yield/node/parity.test.mjs",
    "wasm": "wasm-pack build crates/tyche-yield --release --target web --out-dir pkg --out-name tyche_yield -- --no-default-features --features wasm"
  },
  "license": "MIT OR Apache-2.0"
}
